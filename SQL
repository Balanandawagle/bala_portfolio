-- =============================================================================
-- Database Creation
-- =============================================================================
CREATE DATABASE IF NOT EXISTS `portfolio_db` 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

USE `portfolio_db`;

-- =============================================================================
-- 1. Table: profile (User Profile, Bio, Stats & CV Path)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `profile` (
    `id` INT PRIMARY KEY DEFAULT 1,
    `name` VARCHAR(150) NOT NULL,
    `tagline` VARCHAR(255) DEFAULT '',
    `hero_title` VARCHAR(255) DEFAULT '',
    `bio` TEXT,
    `about_text` TEXT,
    `status_text` VARCHAR(150) DEFAULT 'Available for Projects',
    `location` VARCHAR(150) DEFAULT 'Kathmandu, Nepal',
    `email` VARCHAR(150) DEFAULT 'wagleom@gmail.com',
    `resume_url` VARCHAR(255) DEFAULT '',
    `years_exp` INT DEFAULT 2,
    `articles_written` INT DEFAULT 1000,
    `updated_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =============================================================================
-- 2. Table: projects (Projects CRUD with Image Path)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `projects` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `title` VARCHAR(255) NOT NULL,
    `description` TEXT NOT NULL,
    `tech_stack` VARCHAR(255) DEFAULT '',
    `project_url` VARCHAR(255) DEFAULT '#',
    `image_path` VARCHAR(255) DEFAULT 'assets/finance.jpg',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =============================================================================
-- 3. Table: experience (Work Experience Timeline)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `experience` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `role_title` VARCHAR(255) NOT NULL,
    `company` VARCHAR(255) NOT NULL,
    `employment_type` VARCHAR(100) DEFAULT 'Full-time',
    `timeline` VARCHAR(100) NOT NULL,
    `location` VARCHAR(150) DEFAULT 'Remote',
    `skills_used` VARCHAR(255) DEFAULT '',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =============================================================================
-- 4. Table: education (Education & Degrees)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `education` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `degree` VARCHAR(255) NOT NULL,
    `institution` VARCHAR(255) NOT NULL,
    `gpa` VARCHAR(50) NOT NULL,
    `timeline` VARCHAR(100) NOT NULL,
    `skills_covered` VARCHAR(255) DEFAULT '',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =============================================================================
-- 5. Table: certificates (Licenses & Certifications)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `certificates` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `title` VARCHAR(255) NOT NULL,
    `issuer` VARCHAR(255) NOT NULL,
    `issue_date` VARCHAR(100) NOT NULL,
    `credential_url` VARCHAR(255) DEFAULT '#',
    `skills_covered` VARCHAR(255) DEFAULT '',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =============================================================================
-- 6. Table: contact_messages (Contact Form Leads)
-- =============================================================================
CREATE TABLE IF NOT EXISTS `contact_messages` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `name` VARCHAR(150) NOT NULL,
    `email` VARCHAR(150) NOT NULL,
    `subject` VARCHAR(255) NOT NULL,
    `message` TEXT NOT NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


